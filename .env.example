# CopilotKit Intelligence (Process A - Channels listener)
CPK_INTELLIGENCE_API_KEY=cpk-...
CHANNEL_CODE=angie
# Optional self-host overrides; leave unset for CopilotKit cloud.
# INTELLIGENCE_API_URL=
# INTELLIGENCE_GATEWAY_WS_URL=

# Trigger.dev (Process A triggers; Process B is the dev worker)
TRIGGER_SECRET_KEY=tr_dev_sk_...

STATE_DIR=/absolute/path/to/durable-coworker/state

PORT=3000

# Ambiguous (lane D). Mint your own with: npx ambiguous auth signup
AMBIGUOUS_API_KEY=ak_...
AMBIGUOUS_MCP_URL=https://app.ambiguous.ai/mcp

# Lane C planner. OpenRouter is OpenAI-API-compatible: same SDK, different baseURL.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.8-flash
# Optional deterministic demo only. Without this flag, missing/model failures stop planning visibly.
# PLANNER_MODE=stub

# Live Slack dataset approvals. Map each seeded approver to a real workspace member
# ID. Two humans can cover multiple fictional personas, but keep two approvers on a
# single work order distinct. Do not use display names or U_SAM/the agent.
# DATASET_SLACK_USERS={"U_MAYA":"U012REALMAYA","U_LEO":"U012REALLEO","U_PRIYA":"U012REALMAYA","U_JULES":"U012REALLEO"}
